ials_annual": [], "market_data": {"symbol": "KVAL", "as_of": "2026-08-23", "collected_at": "2026-08-23T19:00:08.567403", "price": 82.0, "previous_close": 82.0, "closing_price": 82.0, "open": 82.0, "high": 82.0, "low": 81.9, "turnover": 26646.0, "share_volume": 325.0, "market_cap": 5576000000.0, "shares_outstanding": 68000000.0, "source": "tradeSummary", "valuation": null}, "thesis": null, "ratios": {"GROUP": []}, "report_diff": {"GROUP": []}, "interim_updates": [{"symbol": "KVAL", "company_name": "KELANI VALLEY PLANTATIONS PLC", "period_label": "Q1 FY2026/27 (quarter ended 30 June 2026)", "period_end_date": "2026-06-30", "generated_at": "2026-08-06T11:39:54.207797+00:00", "note_text": "Kelani Valley Plantations posted Group revenue of Rs.4.996bn for Q1 FY2026/27 (quarter ended 30 June 2026), down 3% YoY, with gross profit down 5% (Rs.628.4mn to Rs.595.0mn) and Results from Operating Activities down 16% (Rs.291.2mn to Rs.243.7mn) -- a genuine core-operating decline. PBT was nonetheless roughly flat (+1%, Rs.282.2mn to Rs.284.5mn) because net finance income swung from a Rs.10.7mn cost to a Rs.57.3mn gain, as finance income nearly tripled (Rs.88.4mn to Rs.256.6mn) -- this offset the operating decline and higher finance expenses, and is a non-operating item rather than a sign of improving core profitability. By segment, Rubber gross margin compressed most (9.8% to 7.4% of revenue), while Tea (the largest segment) was roughly stable (11.9% to 11.8% gross margin) and Others grew both revenue (+41%) and gross profit (+6%). Group PAT of Rs.195.0mn (+1% YoY) masks a shift in mix toward the parent: profit attributable to equity holders rose 2% (Rs.187.7mn to Rs.192.4mn) while the non-controlling interest share fell 54% (Rs.5.7mn to Rs.2.6mn).", "source_doc_id": "52231", "source_page": 4, "gaps_note": "No QoQ comparison possible: no quarter closer to this one (e.g. 31 March 2026) has been collected for KVAL -- this is the first financial_statements entry for this symbol. Unlike several other companies entered this round, this filing's comparative for both the income statement and cash flow is a genuine prior-year quarter (not an annual figure), so the YoY comparison above is fully like-for-like.", "takeaway": "Core plantation operations weakened YoY (revenue -3%, gross profit -5%, operating profit -16%), but this was fully offset at the PBT line by a large, non-operating swing in net finance income -- worth reading the headline 'PBT roughly flat' figure with that context rather than at face value, since the underlying tea/rubber business is genuinely softer this quarter, particularly in Rubber.", "qoq": [], "yoy": [{"metric": "revenue", "label": "Revenue", "prior_period_label": "Q1 FY2025/26 (quarter ended 30 June 2025)", "prior_value": 5136814.0, "new_period_label": "Q1 FY2026/27 (quarter ended 30 June 2026)", "new_value": 4996372.0, "pct_change": -0.027340293029881946, "direction": "deteriorated", "prior_period_end_date": "2025-06-30", "new_period_end_date": "2026-06-30"}, {"metric": "gross_profit", "label": "Gross Profit", "prior_period_label": "Q1 FY2025/26 (quarter ended 30 June 2025)", "prior_value": 628415.0, "new_period_label": "Q1 FY2026/27 (quarter ended 30 June 2026)", "new_value": 595005.0, "pct_change": -0.05316550368784959, "direction": "deteriorated", "prior_period_end_date": "2025-06-30", "new_period_end_date": "2026-06-30"}, {"metric": "operating_profit", "label": "Operating Profit", "prior_period_label": "Q1 FY2025/26 (quarter ended 30 June 2025)", "prior_value": 291232.0, "new_period_label": "Q1 FY2026/27 (quarter ended 30 June 2026)", "new_value": 243704.0, "pct_change": -0.16319635204922536, "direction": "deteriorated", "prior_period_end_date": "2025-06-30", "new_period_end_date": "2026-06-30"}, {"metric": "profit_before_tax", "label": "Profit Before Tax", "prior_period_label": "Q1 FY2025/26 (quarter ended 30 June 2025)", "prior_value": 282154.0, "new_period_label": "Q1 FY2026/27 (quarter ended 30 June 2026)", "new_v