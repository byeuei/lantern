iggest swing factor on reported profit is excise/tax policy: alcohol is taxed at 40-45% versus the 30% standard corporate rate, and government tax changes move profit directly (Annual Report 2022/23, Chairman's Message).", "gaps_note": "No gaps for FY2020-FY2025 and the latest interim; all figures traced to audited Statement of Profit or Loss tables or the report's own Financial Highlights/Review pages.", "annual": [{"period": "FY2024 (year ended 31 March 2024)", "period_end_date": "2024-03-31", "basis": "GROUP", "revenue": 109755568.0, "operating_income": 15367756.0, "pbt": 14001948.0, "pat": 8403478.0, "eps": 105.04, "currency": "LKR", "source_doc_id": "manual_20e4d7b42c753e77", "source_page": 115}, {"period": "FY2025 (year ended 31 March 2025)", "period_end_date": "2025-03-31", "basis": "GROUP", "revenue": 123431021.0, "operating_income": 16185876.0, "pbt": 15742867.0, "pat": 9508454.0, "eps": 118.86, "currency": "LKR", "source_doc_id": "manual_20e4d7b42c753e77", "source_page": 115}], "quarterly": [{"period": "Q2 FY2025/26 (quarter ended 30 Sep 2025)", "period_end_date": "2025-09-30", "basis": "COMPANY", "revenue": 35158889.0, "operating_income": null, "pbt": null, "pat": 3122687.0, "eps": 39.03, "currency": "LKR", "source_doc_id": "manual_b9529123ed55a743", "source_page": 2}], "market_data": {"symbol": "LION", "as_of": "2026-08-22", "collected_at": "2026-08-22T11:00:07.817692", "price": 1726.5, "previous_close": 1726.5, "closing_price": 1726.5, "open": 1830.0, "high": 1830.0, "low": 1750.0, "turnover": 61981.0, "share_volume": 34.0, "market_cap": 138120000000.0, "shares_outstanding": 80000000.0, "source": "tradeSummary"}, "valuation": {"price": 1726.5, "market_cap": 138120000000.0, "enterprise_value": 129571731000.0, "pe_ratio": 14.525492175668854, "pb_ratio": 4.012794923866717, "ev_ebitda": 6.815719647426276, "dividend_yield": 0.02664349840718216, "payout_ratio": 0.38700992764597003, "_gaps": []}, "ratios_annual": {"gross_profit": 28811320.0, "gross_margin": 0.